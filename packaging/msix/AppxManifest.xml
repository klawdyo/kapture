<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifesto do pacote MSIX do Cap.

  PLACEHOLDERS que devem ser trocados pelos valores do Partner Center
  (Microsoft Store > Gerenciamento de identidade do app):
    - Identity/@Name       : "Package/Identity/Name"      (ex.: 12345Fulano.Cap)
    - Identity/@Publisher  : "Package/Identity/Publisher" (ex.: CN=XXXXXXXX-XXXX-...)
    - PublisherDisplayName : nome de exibição do publicador
  Enquanto forem placeholders, o pacote serve apenas para testes locais.
  @VERSION@ é substituído por build-msix.ps1 (formato A.B.C.D).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="PLACEHOLDER.Cap"
            Publisher="CN=PLACEHOLDER-PUBLISHER-ID"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Cap</DisplayName>
    <PublisherDisplayName>PLACEHOLDER Publisher</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-BR" />
  </Resources>

  <Applications>
    <Application Id="Cap" Executable="cap.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Cap"
        Description="Gravador de tela leve com webcam e microfone"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150.png"
        Square44x44Logo="Assets\Square44x44.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
