{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kapture",
  "mainBinaryName": "kapture",
  "version": "0.1.0",
  "identifier": "com.klawdyo.kapture",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "toolbar",
        "title": "kapture",
        "url": "index.html",
        "width": 720,
        "height": 136,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["mica"] },
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "webcam",
        "title": "Webcam",
        "url": "webcam.html",
        "width": 240,
        "height": 240,
        "minWidth": 96,
        "minHeight": 96,
        "maxWidth": 640,
        "maxHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "create": false
      },
      {
        "label": "region-selector",
        "title": "Selecionar área",
        "url": "region.html",
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "licenseFile": "license.rtf",
    "publisher": "kapture",
    "shortDescription": "kapture, gravador de tela leve",
    "longDescription": "kapture é um gravador de tela leve para Windows, com webcam, microfone e encoder nativo.",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "wix": { "language": "pt-BR" }
    }
  }
}
